# =============================================================================
# Economist Weekly Archiver — Environment Variables
# Copy this file to `.env` and fill in real values.
# 真实凭据只放在 `.env`(已被 .gitignore),绝对不要提交到仓库。
# =============================================================================

# --- LLM (OpenAI 兼容协议) ----------------------------------------------------
# 必填:大模型 API key
LLM_API_KEY=sk-REPLACE-ME
# 自建网关或代理(留空 = 走官方 https://api.openai.com/v1)
LLM_BASE_URL=
# 模型名称
LLM_MODEL=gpt-4o-mini

# --- Feishu (Lark) 通知 ------------------------------------------------------
# 飞书自定义机器人 webhook URL;留空 = 不推送(仅写盘)
FEISHU_WEBHOOK_URL=

# 1. 飞书开放平台凭证
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx