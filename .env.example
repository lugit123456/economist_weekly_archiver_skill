# =============================================================================
# Economist Weekly Archiver — Environment Variables
# Copy this file to `.env` and fill in real values.
# 真实凭据 / 路径 / 调优参数全部在这里,无 config.json。
# 已被 .gitignore,绝对不要提交到仓库。
# =============================================================================

# --- LLM (OpenAI 兼容协议) ----------------------------------------------------
# 必填:大模型 API key
LLM_API_KEY=sk-REPLACE-ME
# 自建网关或代理(留空 = 走官方 https://api.openai.com/v1)
LLM_BASE_URL=
# 模型名称
LLM_MODEL=gpt-4o-mini
# 单次响应最大 token 数(默认 2048)
LLM_MAX_TOKENS=
# 温度参数(默认 0.4)
LLM_TEMPERATURE=
# HTTP 超时秒数(默认 60)
LLM_TIMEOUT_S=

# --- Feishu (Lark) 通知 ------------------------------------------------------
# 飞书自定义机器人 webhook URL;留空 = 不推送(仅写盘)
FEISHU_WEBHOOK_URL=

# 1. 飞书开放平台凭证
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- 浏览器(Chrome 复用 profile 路径,跨平台) ---------------------------------
# Mac 默认: ~/Library/Application Support/economist_archive/chrome_profile
# Linux:   ~/.config/economist_archive/chrome_profile
# Windows: %APPDATA%\economist_archive\chrome_profile
# 留空 = 默认 Mac 路径 /Users/luzhe/.economist_archive/chrome_profile
BROWSER_USER_DATA_PATH=
# 是否无头模式(默认 false,留空 = false;true / 1 / yes = true)
BROWSER_HEADLESS=

# --- 抓取调优 -----------------------------------------------------------------
# 两次抓取之间的最小间隔秒数(防风控,默认 5)
CRAWL_DELAY_MIN_S=
# 最大间隔秒数(默认 10,实际间隔在 [min, max] 之间随机)
CRAWL_DELAY_MAX_S=
# LLM 调用失败重试次数(默认 2,加上首次共 3 次)
CRAWL_MAX_RETRIES=

# --- 输出路径(可选,全部不填则用项目内默认路径) -----------------------------
# 抓取数据持久化的 database.js 路径(默认:项目根/database.js)
DATABASE_JS_PATH=
# 生成的 index.html 路径(默认:项目根/index.html)
INDEX_HTML_PATH=
# 模板路径(默认:项目根/index.html — 即当前 index.html 自己作为模板)
INDEX_HTML_TEMPLATE=
# 留空 = 用默认值;填了则 sync_weekly.py 每抓一篇会重新生成一份「数据库内联」的自包含 index.html 到指定路径,
# 双击任意位置的该 HTML 都能直接浏览(无需 database.js 同目录)。